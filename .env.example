# Copy to .env and fill in. Only needed for the --llm narrative assessor.
# The .env file is git-ignored, so your real key is never committed.
# Set credentials for whichever --provider you use; the others can stay blank.

# --provider claude (default) -- Anthropic
ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5

# --provider openai -- public OpenAI API
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o

# --provider openai, with an endpoint set -- Azure OpenAI instead of public OpenAI
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_VERSION=2024-10-21
# AZURE_OPENAI_DEPLOYMENT=<your-deployment-name>

# Shared
# LLM_MAX_TOKENS=2000

# Gmail report delivery (use a Google App Password, not your account password)
# GMAIL_ADDRESS=your-sender@gmail.com
# GMAIL_APP_PASSWORD=your-16-character-app-password
